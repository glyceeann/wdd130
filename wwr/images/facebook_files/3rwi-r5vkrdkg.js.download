const float MEDIUM_FLOW_SCALE = 0.20;
const float SMALL_FLOW_SCALE = 1.5;
const float TAPER_RANDOM_VARIATION = 0.1;
const float RANDOM_MOTION_AMPLITUDE = 0.086;
